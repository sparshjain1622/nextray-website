PORT=4000
FRONTEND_URL=http://localhost:3000

# Supabase PostgreSQL (Project Settings → Database → URI)
# Add ?sslmode=require if missing
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require"

# REQUIRED in production: openssl rand -hex 32
JWT_SECRET=generate-a-strong-random-secret-min-32-chars

ADMIN_EMAIL=admin@nextray-tech.com
ADMIN_PASSWORD=change-this-strong-password

# Gmail SMTP — use App Password (not regular Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=jsparsh11@gmail.com
SMTP_PASS=your-gmail-16-char-app-password
SMTP_FROM=jsparsh11@gmail.com
NOTIFY_EMAIL=jsparsh11@gmail.com

# --- Production example (Render + Vercel free URLs) ---
# FRONTEND_URL=https://nextray.vercel.app
# DATABASE_URL=<supabase-uri>
